# Application
APP_ENV=development
HTTP_PORT=8080
HTTP_ADDR=0.0.0.0
PUBLIC_API_URL=http://localhost:8080

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5433/toko_online?sslmode=disable
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# Supabase Storage
# URL project Supabase, contoh: https://<project-ref>.supabase.co
SUPABASE_URL=
# URL publik yang sama dengan SUPABASE_URL jika bucket dibuat public
SUPABASE_PUBLIC_URL=
SUPABASE_STORAGE_BUCKET=product-images
# Gunakan service_role key hanya di backend; jangan pernah commit atau kirim ke frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Shipping
SHIPPING_PROVIDER=mock
# BITESHIP_API_KEY=your-api-key (uncomment for production)
ORIGIN_LATITUDE=-6.2088
ORIGIN_LONGITUDE=106.8456

# Email/SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@toko-online.local

# Admin seed
ADMIN_EMAIL=admin@toko-online.local
ADMIN_PASSWORD=Admin@123456

# Payment
PAYMENT_EXPIRY_HOURS=24
LOW_STOCK_THRESHOLD=10

# Job scheduler
JOB_PAYMENT_EXPIRY_INTERVAL=1m
JOB_SHIPPING_POLL_INTERVAL=6h

# Logging
LOG_LEVEL=info
